# Optional. Without a key the keyless public API is used (lowest rate limits).
# Get a free Demo key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# public | demo | pro   (defaults to demo when a key is set)
COINGECKO_API_PLAN=

# Market data cache (seconds). CoinGecko's free plans update this data every few
# minutes and allow a small number of calls per minute, so caching is on by default.
CACHE_TTL_SECONDS=300
STALE_TTL_SECONDS=3600

# Restrict which coins this server will chart (comma separated). Empty = any id.
ALLOWED_COINS=
DEFAULT_COIN=bitcoin

# Per-client limits (flask-limiter syntax). Use redis://... to share across instances.
RATE_LIMIT_CHART=20 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of the app that set X-Forwarded-For (0 = trust none).
TRUSTED_PROXIES=0

# Comma separated origins allowed to call the API from a browser.
CORS_ORIGINS=
LOG_LEVEL=INFO
PORT=8000
